<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Row: Doctor Name + Category badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Doctor Name -->
            <TextView
                android:id="@+id/tvDoctorName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Dr. Name"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#111111"/>

            <!-- ✅ Category badge -->
            <TextView
                android:id="@+id/tvCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Academic"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:background="#F32B2B"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"/>

        </LinearLayout>

        <!-- Course Name -->
        <TextView
            android:id="@+id/tvCourseName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Course Name"
            android:textSize="13sp"
            android:textColor="#888888"
            android:layout_marginTop="2dp"/>

        <!-- ✅ Author name -->
        <TextView
            android:id="@+id/tvAuthorName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="by Student"
            android:textSize="12sp"
            android:textColor="#AAAAAA"
            android:layout_marginTop="2dp"/>

        <!-- Rating Bar -->
        <RatingBar
            android:id="@+id/ratingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:numStars="5"
            android:rating="4"
            android:stepSize="0.5"
            android:isIndicator="true"
            style="?attr/ratingBarStyleSmall"/>

        <!-- Review Text -->
        <TextView
            android:id="@+id/txtReview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Review text goes here..."
            android:textColor="#555555"
            android:textSize="14sp"/>

        <!-- Hidden badge -->
        <TextView
            android:id="@+id/tvHiddenBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text=" HIDDEN "
            android:textSize="10sp"
            android:textColor="#FFFFFF"
            android:background="#B00020"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:visibility="gone"/>

        <!-- Moderation buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnHideReview"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Hide"
                android:textSize="12sp"
                android:layout_marginEnd="8dp"
                android:visibility="gone"
                style="@style/Widget.Material3.Button.TextButton"/>

            <Button
                android:id="@+id/btnDeleteReview"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Delete"
                android:textSize="12sp"
                android:textColor="#B00020"
                android:visibility="gone"
                style="@style/Widget.Material3.Button.TextButton"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>